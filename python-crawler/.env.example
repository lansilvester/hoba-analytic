BACKEND_API_URL=http://127.0.0.1:8000/api
CRAWLER_API_TOKEN=crawler-change-me
SOURCE_TIMEOUT_SECONDS=15
USER_AGENT=Mozilla/5.0 (compatible; PixelJoyCrawler/0.1)
SCHEDULER_INTERVAL_MINUTES=30
MAX_ARTICLES_PER_SOURCE=25

# Apify (X/Twitter, YouTube, Instagram) — kosongkan untuk melewati kolektor sosial
APIFY_TOKEN=
APIFY_TIMEOUT_MINUTES=15

# X / Twitter
TWITTER_ACTOR_ID=apidojo/tweet-scraper
TWITTER_MAX_ITEMS=200
TWITTER_LANGUAGE=id

# YouTube
YOUTUBE_ACTOR_ID=apify/youtube-scraper
YOUTUBE_MAX_VIDEOS=50
YOUTUBE_COMMENTS_MAX_PER_VIDEO=20

# Instagram
INSTAGRAM_ACTOR_ID=apify/instagram-hashtag-scraper
INSTAGRAM_MAX_ITEMS=100
INSTAGRAM_SCRAPE_COMMENTS=true
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
